# Copy to `.env` (which is gitignored) and fill in.
#
# NEVER put a private key in here. Deployment uses a `cast` keystore:
#   cast wallet import maren-deployer --interactive
#   forge script ... --account maren-deployer

# RPC endpoints. Both verified live with `cast chain-id` — see packages/sdk/src/chains.ts
# for why several URLs in Mezo's own docs do not resolve, and why failover is not optional.
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
MEZO_MAINNET_RPC_URL=https://jsonrpc-mezo.boar.network

# Setting MEZO_TESTNET_RPC_URL also switches on the fork suite:
#   forge test --match-path 'test/fork/*'
# Fork tests skip rather than fail when it is unset, so a flaky public testnet
# cannot break CI.

# Deploy-time roles. All three default to the broadcaster when unset, which is fine for
# matsnet and NOT fine for mainnet — MAREN_ADMIN must be a multisig there.
# MAREN_ADMIN=0x
# MAREN_KEEPER=0x
# MAREN_GUARDIAN=0x

# Deposit caps, in wei. Both default deliberately small (5 BTC / 250,000 MUSD).
# VAULT_DEPOSIT_CAP=5000000000000000000
# EARN_DEPOSIT_CAP=250000000000000000000000
