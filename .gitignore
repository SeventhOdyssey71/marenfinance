# dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# builds
dist/
build/
out/

# ...except the document set, which is committed so the PDFs can be linked and reviewed
# without a local build. See docs/build/.gitignore.
!docs/build/
.next/
.turbo/
.expo/
*.tsbuildinfo

# foundry
packages/contracts/out/
packages/contracts/cache/
# Dry-run artifacts are throwaway simulation output. Real broadcast artifacts
# (broadcast/<script>/<chainid>/run-*.json) ARE committed — they carry the tx hashes.
# NOTE: the glob needs `**`; the path is broadcast/<script>/<chainid>/dry-run/, which is
# one level deeper than a single `*` matches.
packages/contracts/broadcast/**/dry-run/
packages/contracts/lib/

# env & secrets — NEVER commit
.env
.env.*
!.env.example
# The relayer's deployment env is `.env.relayer`, which `.env.*` above ignores.
# Its template carries no secrets and must be committed, so it is re-included by
# name rather than by loosening the glob.
!.env.relayer.example
*.pem
*.key
*.keystore
secrets.json
# Keystore + passphrase bind-mounted into the relayer container. Never commit the
# directory, whatever an operator happens to leave in it.
apps/relayer/secrets/

# docs build artifacts (PDFs are committed intentionally, see docs/build/.gitignore)
docs/.tmp/

# ios / native
ios/Pods/
ios/build/
*.xcuserstate
*.xcworkspace/xcuserdata/
DerivedData/
*.ipa
*.dSYM.zip

# testing
coverage/
.nyc_output/
# `forge coverage --report lcov` drops this in packages/contracts. The nightly reads it
# for the MarenVault floor and uploads it as an artifact; it is never committed.
lcov.info

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/

# vercel
.vercel

# agent worktrees and local editor/agent state — never commit.
# `.claude/worktrees/` alone left `.claude/settings.local.json` untracked but NOT
# ignored, one `git add -A` away from being committed.
.claude/

# research scratch — agents occasionally drop probe output in the repo root
/*.tmp
/r*.json
/chains.json
/pim.html

# Private grant package — context, pitch, and correspondence. Never committed.
_grant/

# agent working litter, never source
.harness/
scratch/
Screenshot*.png

# Cloudflare Wrangler local secrets (never commit)
.dev.vars
**/.dev.vars
.wrangler/

# Local design source assets (fonts + raw screenshots); the app ships derived woff2 + public/shots
design/
