# dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# builds
dist/
build/
out/

# ...except the document set, which is committed so the PDFs can be linked and reviewed
# without a local build. See docs/build/.gitignore.
!docs/build/
.next/
.turbo/
.expo/
*.tsbuildinfo

# foundry
packages/contracts/out/
packages/contracts/cache/
packages/contracts/broadcast/*/dry-run/
packages/contracts/lib/

# env & secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
secrets.json

# docs build artifacts (PDFs are committed intentionally, see docs/build/.gitignore)
docs/.tmp/

# ios / native
ios/Pods/
ios/build/
*.xcuserstate
*.xcworkspace/xcuserdata/
DerivedData/
*.ipa
*.dSYM.zip

# testing
coverage/
.nyc_output/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/

# vercel
.vercel
