# Maren relayer: deployment environment.
#
#   cp apps/relayer/.env.relayer.example apps/relayer/.env.relayer
#
# `.env.relayer` is gitignored (the root .gitignore ignores `.env.*`). It holds
# no secret in the preferred setup: the hot key lives in a keystore file and its
# passphrase in a second file, and only their PATHS appear below.
#
# Anything left unset that has no safe default becomes a boot problem, and the
# relayer answers 503 with the reason on /healthz rather than relaying. That is
# the intended behaviour, not a misconfiguration to work around.

# --- network -----------------------------------------------------------------
RELAYER_NETWORK=testnet
# Optional. Defaults to the verified endpoints for the network, in failover
# order. Add endpoints rather than replacing them.
# RELAYER_RPC_URLS=https://rpc.test.mezo.org

# --- signing key (preferred mode) --------------------------------------------
# Created with: cast wallet import maren-relayer --interactive
# Then copy ~/.foundry/keystores/maren-relayer into the mounted secrets dir.
RELAYER_KEYSTORE_PATH=/run/secrets/maren/keystore.json
RELAYER_KEYSTORE_PASSWORD_FILE=/run/secrets/maren/passphrase

# DEVELOPMENT ONLY. A raw key here is readable by anything that can read this
# process environment, and it is a hard boot problem on mainnet.
# RELAYER_PRIVATE_KEY=0x...

# --- the two numbers that bound what we can lose ------------------------------
# No defaults, on purpose. Unset means nothing is sponsored.
RELAYER_MAX_DAILY_SPONSORED_BTC=0.002
# Unset means the paid tier is CLOSED once an address spends its free actions,
# which is the correct setting until MarenRelayHub ships.
# RELAYER_FEE_MUSD=0.05

# --- allowlist ----------------------------------------------------------------
# Falls back to the non-zero addresses in @maren/sdk. Set explicitly to pin them.
# RELAYER_FORWARDER_ADDRESS=0x...
# RELAYER_ALLOWED_TARGETS=marenPay:0x...,marenRegistry:0x...

# --- policy -------------------------------------------------------------------
# RELAYER_FREE_ACTIONS_PER_ADDRESS=25
# RELAYER_MAX_ACTIONS_PER_ADDRESS_DAY=50
# RELAYER_MAX_ACTIONS_PER_IP_DAY=200

# --- storage and operations ---------------------------------------------------
# `memory` is correct for the single-instance deployment this service is built
# for. It is a boot problem only on a multi-instance host, where per-instance
# counters would remove the global BTC cap rather than weaken it.
RELAYER_STORE=memory
# Required if this sits behind a reverse proxy, otherwise every client shares one
# per-IP bucket (safe, but it will throttle real traffic).
# RELAYER_TRUSTED_PROXIES=172.18.0.0/16
LOG_LEVEL=info

# Browser origins allowed to call /relay (CORS). Comma-separated; empty denies cross-origin.
RELAYER_ALLOWED_ORIGINS=https://marenfinance.vercel.app,http://localhost:3000
