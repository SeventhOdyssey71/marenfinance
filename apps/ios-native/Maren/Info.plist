<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist for custom keys only. GENERATE_INFOPLIST_FILE=YES still injects the
  standard Apple keys (INFOPLIST_KEY_* in project.yml) into this file at build time.

  MAREN_RELAYER_URL is the hosted relayer the app talks to. RelayerConfig.url lets a
  process-environment MAREN_RELAYER_URL override it for local dev, so this is the default,
  not a hard pin.
-->
<plist version="1.0">
<dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>finance.maren.app.handoff</string>
            <key>CFBundleURLSchemes</key>
            <array><string>maren</string></array>
        </dict>
    </array>
    <!-- Goldsky subgraph for Activity history. EMPTY IS VALID: the client falls back to the
         bounded eth_getLogs crawl, which is slower but needs no infrastructure. Fill this in
         after `goldsky subgraph deploy` and the Activity screen stops paging. -->
    <key>MAREN_SUBGRAPH_URL</key>
    <string></string>
    <key>MAREN_RELAYER_URL</key>
    <string>https://maren-relayer.rolandojude18.workers.dev</string>
    <!-- Public identity of the testnet-only App Review wallet. The access code and derived
         private key are supplied privately in App Store Connect and never ship in the app. -->
    <key>MAREN_REVIEW_EMAIL</key>
    <string>appreview@maren.finance</string>
    <key>MAREN_REVIEW_ADDRESS</key>
    <string>0xE86De53Ff4c3C223F7D1cF2F4ed23D50899dD3CC</string>
    <!--
      Export-compliance declaration. Maren only uses standard, exempt cryptography: HTTPS/TLS
      for network calls, Apple's Keychain/Secure Enclave and secp256k1 signing for the wallet.
      It implements no proprietary or non-standard encryption, so it qualifies for the App
      Store export-compliance exemption. NO means "no non-exempt encryption", which lets
      TestFlight builds skip the manual export-compliance questionnaire on every upload.
    -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
