# Maren web (apps/web) — environment
#
# For Vercel: Project → Settings → Environment Variables, then add each key below.
# Copy to a local .env.local for development (it is gitignored).
#
# Everything here is NEXT_PUBLIC_* — it is compiled into the browser bundle, so it
# holds NO secret. Server-only secrets (the relayer hot key, the deployer key, Redis
# tokens) belong to the relayer and contracts, never here — see the repo-root
# .env.example for those.
#
# Only NEXT_PUBLIC_MEZO_NETWORK is needed for a first deploy. Every other value has a
# clean fallback and can be added later without breaking the build.

# ── Network (required) ──────────────────────────────────────────────────────────
# "testnet" (matsnet, chain 31611) or "mainnet" (31612). Defaults to testnet.
NEXT_PUBLIC_MEZO_NETWORK=testnet

# ── Google sign-in · Privy (optional) ────────────────────────────────────────────
# Enables "Continue with Google, no seed phrase". BLANK → the app falls back cleanly
# to the wallet-connect flow below; nothing breaks. Setup (https://dashboard.privy.io):
#   1. Create an app; copy its App ID here.
#   2. Login methods → enable Google (OAuth) and Wallet.
#   3. Embedded wallets → Ethereum → create for "users without wallets".
#   4. Networks → add Mezo Matsnet 31611 (and 31612 if you run mainnet).
#   5. Domains → allowlist your Vercel URL(s) so the OAuth redirect is accepted.
NEXT_PUBLIC_PRIVY_APP_ID=

# ── WalletConnect · Reown (optional, recommended) ─────────────────────────────────
# Lets people connect external wallets over WalletConnect. Get a project id at
# https://dashboard.reown.com . BLANK → injected/browser wallets still connect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Gasless relayer (optional) ────────────────────────────────────────────────────
# The hosted relayer that pays BTC gas for sponsored writes. BLANK or unreachable →
# writes decline honestly ("no relayer configured") instead of faking a receipt.
# Point this at your deployed relayer once it is live (apps/relayer/DEPLOY.md).
NEXT_PUBLIC_RELAYER_URL=

# ── Privy secure-site (optional, advanced) ────────────────────────────────────────
# Only if you self-host Privy's embedded-wallet secure iframe. Leave unset to use
# Privy's hosted default.
NEXT_PUBLIC_SECURE_SITE_ORIGIN=
NEXT_PUBLIC_SECURE_SITE_SDK_URL=
NEXT_PUBLIC_SECURE_SITE_SDK_VERSION=

# ── Diagnostics (optional) ────────────────────────────────────────────────────────
# Client log verbosity: error | warn | info | debug. Defaults to warn.
NEXT_PUBLIC_DEFAULT_LOG_LEVEL=warn
