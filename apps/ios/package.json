{
  "name": "@maren/ios",
  "version": "0.1.0",
  "private": true,
  "description": "Maren Finance for iOS \u2014 Bitcoin-backed account on Mezo Chain. Expo + expo-router.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured yet - see apps/ios/README.md' && exit 0",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .expo dist .turbo node_modules"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.10",
    "@maren/sdk": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.13",
    "expo-auth-session": "~57.0.7",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "viem": "^2.55.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
