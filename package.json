{
  "name": "maren",
  "version": "0.1.0",
  "private": true,
  "description": "Maren Finance \u2014 Bitcoin liquidity, gasless spending, earn yield. Built on Mezo Chain.",
  "license": "MIT",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "release:check": "node tools/release/check.mjs --web-app --require-recovery",
    "release:test": "pnpm --filter @maren/release test",
    "release:attest": "pnpm --filter @maren/release attest",
    "clean": "turbo run clean && rm -rf node_modules",
    "contracts:build": "forge build --root packages/contracts --sizes",
    "contracts:test": "forge test --root packages/contracts",
    "contracts:fmt": "forge fmt --root packages/contracts --check",
    "docs:pdf": "node tools/pdf/build.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "docs:preview": "node tools/pdf/preview.mjs",
    "docs:stamp": "node tools/docs/stamp-live.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
