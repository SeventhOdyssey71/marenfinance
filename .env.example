# ── Network ───────────────────────────────────────────────────────────────────
# "testnet" (matsnet, 31611) or "mainnet" (31612). Defaults to testnet.
NEXT_PUBLIC_MEZO_NETWORK=testnet

# ── Wallets ───────────────────────────────────────────────────────────────────
# https://dashboard.reown.com — required for WalletConnect / Reown AppKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Google sign-in (Privy) ────────────────────────────────────────────────────
# Enables "Continue with Google, no seed phrase": Privy mints an embedded Mezo EOA
# for users without a wallet, bridged onto the existing wagmi setup. Leave BLANK and
# the app falls back cleanly to the wallet-connect flow above — nothing breaks.
#
# To go live (https://dashboard.privy.io):
#   1. Create an app; copy its App ID here.
#   2. Login methods → enable Google (OAuth) and Wallet.
#   3. Embedded wallets → Ethereum → create on login: "users without wallets".
#   4. Networks → add Mezo Matsnet testnet (chain 31611); add mainnet 31612 too if used.
#   5. Domains → allowlist the app's origin(s) so the OAuth redirect is accepted.
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Relayer (gasless) ─────────────────────────────────────────────────────────
# Full reference: apps/relayer/README.md
NEXT_PUBLIC_RELAYER_URL=http://localhost:8787
RELAYER_NETWORK=testnet

# Hot key that pays BTC gas for sponsored transactions. NEVER commit a real value.
# PREFERRED: a `cast wallet import` keystore plus its passphrase in a FILE, so
# neither secret is readable from the process environment. Deployment walkthrough:
# apps/relayer/DEPLOY.md.
RELAYER_KEYSTORE_PATH=
RELAYER_KEYSTORE_PASSWORD_FILE=
# The passphrase in the environment instead. Accepted, warned about at boot.
RELAYER_KEYSTORE_PASSWORD=
# DEVELOPMENT ONLY. Warned about at every boot, and a boot PROBLEM on mainnet.
RELAYER_PRIVATE_KEY=

# Contracts the relayer may call. `name:address` pairs, comma separated.
# Until MarenForwarder is deployed these are empty and the relayer REFUSES to
# relay. That is the intended default state, not a bug — see R8.
RELAYER_FORWARDER_ADDRESS=
RELAYER_ALLOWED_TARGETS=

# Hard cap on BTC gas spend per UTC day. NO DEFAULT: unset means nothing is
# sponsored at all. A missing budget must never become an unbounded subsidy.
RELAYER_MAX_DAILY_SPONSORED_BTC=0.01

# Sponsorship policy. First 25 actions per address are free; after that the
# request must carry `relayFee >= RELAYER_FEE_MUSD` inside its SIGNED calldata.
# Unset RELAYER_FEE_MUSD closes the paid tier rather than making it free.
RELAYER_FEE_MUSD=0.05
RELAYER_FREE_ACTIONS_PER_ADDRESS=25
RELAYER_MAX_ACTIONS_PER_ADDRESS_DAY=50
RELAYER_MAX_ACTIONS_PER_IP_DAY=200

# RPC endpoints in failover order, comma separated. Defaults to every endpoint in
# @maren/sdk's chain definition, already ordered by observed stability.
# Prefer ADDING endpoints over removing them: Mezo's public RPCs transiently
# answer -32601 "method does not exist" while a backend is degraded, so a single
# bad probe is not evidence an endpoint lacks a feature. The relayer repeat-probes
# at boot and fails over at runtime; no provider is blocked in code.
RELAYER_RPC_URLS=

# Quota storage. "memory" is per-instance and therefore per-instance limits;
# use "redis" for anything multi-instance (Vercel).
RELAYER_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fixed salt for per-IP rate-limit buckets. REQUIRED on multi-instance deploys,
# otherwise each instance counts IPs separately and the limit multiplies.
# Under VERCEL, both this and RELAYER_STORE=redis are enforced at boot: with
# per-instance counters the global daily BTC cap is not weakened, it is removed.
RELAYER_IP_SALT=

# Rate-limit identity. `x-forwarded-for` is read ONLY from these proxies, and
# then the rightmost untrusted hop is used. With none configured the header is
# IGNORED and the socket address is used — never trust a client-supplied header
# for a limit the client can bypass by rewriting it.
RELAYER_TRUSTED_PROXIES=
# Unforgeable platform header carrying the client IP. Defaults to
# x-vercel-forwarded-for when VERCEL is present.
RELAYER_CLIENT_IP_HEADER=

# Tighter gas ceiling for ERC-1271 / EIP-7702 contract signers, whose signature
# validation runs arbitrary code inside the transaction we pay for.
# Always clamped to RELAYER_MAX_GAS_PER_REQUEST.
RELAYER_MAX_GAS_CONTRACT_SIGNER=500000

# ── Deployment ────────────────────────────────────────────────────────────────
# Used by forge script. NEVER commit a real value — prefer `cast wallet` keystores.
DEPLOYER_PRIVATE_KEY=
MEZO_MAINNET_RPC_URL=https://jsonrpc-mezo.boar.network
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
# Blockscout verification (note the api. subdomain)
MEZO_MAINNET_VERIFIER_URL=https://api.explorer.mezo.org/api
MEZO_TESTNET_VERIFIER_URL=https://api.explorer.test.mezo.org/api

# ── Indexing ──────────────────────────────────────────────────────────────────
GOLDSKY_API_KEY=
